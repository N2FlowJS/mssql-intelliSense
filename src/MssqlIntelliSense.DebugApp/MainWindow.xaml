<Window x:Class="MssqlIntelliSense.DebugApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ssms="clr-namespace:MssqlIntelliSense.SsmsHost;assembly=MssqlIntelliSense.SsmsHost"
        xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
        mc:Ignorable="d"
        Title="MSSQL IntelliSense - Standalone UI Debugger" Height="900" Width="1180" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#1B1B1C" Foreground="#E6E6E6">

    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1B1B1C" />
        <SolidColorBrush x:Key="AppPanelBrush" Color="#242426" />
        <SolidColorBrush x:Key="AppPanelAltBrush" Color="#2B2B2E" />
        <SolidColorBrush x:Key="AppInputBrush" Color="#1F1F22" />
        <SolidColorBrush x:Key="AppBorderBrush" Color="#3D3D42" />
        <SolidColorBrush x:Key="AppTextBrush" Color="#E6E6E6" />
        <SolidColorBrush x:Key="AppMutedTextBrush" Color="#A8A8AD" />
        <SolidColorBrush x:Key="AppAccentBrush" Color="#2D7D9A" />
        <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#358DB0" />
        <SolidColorBrush x:Key="AppButtonBrush" Color="#343438" />
        <SolidColorBrush x:Key="AppButtonHoverBrush" Color="#424247" />

        <!-- Standalone defaults for SSMS/VS-themed controls. -->
        <SolidColorBrush x:Key="{x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}" Color="#1B1B1C" />
        <SolidColorBrush x:Key="{x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}" Color="#E6E6E6" />
        <SolidColorBrush x:Key="{x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}" Color="#3D3D42" />
        <SolidColorBrush x:Key="{x:Static vsui:EnvironmentColors.ToolWindowCodeBlockBackgroundBrushKey}" Color="#242426" />
        <SolidColorBrush x:Key="{x:Static vsui:EnvironmentColors.PanelTextBrushKey}" Color="#A8A8AD" />
        <SolidColorBrush x:Key="{x:Static vsui:EnvironmentColors.ComboBoxBackgroundBrushKey}" Color="#1F1F22" />
        <SolidColorBrush x:Key="{x:Static vsui:EnvironmentColors.ComboBoxTextBrushKey}" Color="#E6E6E6" />
        <SolidColorBrush x:Key="{x:Static vsui:EnvironmentColors.ComboBoxBorderBrushKey}" Color="#3D3D42" />
        <SolidColorBrush x:Key="{x:Static vsui:EnvironmentColors.SystemHighlightBrushKey}" Color="#2D7D9A" />
        <SolidColorBrush x:Key="{x:Static vsui:EnvironmentColors.SystemHighlightTextBrushKey}" Color="#FFFFFF" />
        <SolidColorBrush x:Key="{x:Static vsui:EnvironmentColors.SystemButtonFaceBrushKey}" Color="#343438" />
        <SolidColorBrush x:Key="{x:Static vsui:EnvironmentColors.SystemButtonTextBrushKey}" Color="#E6E6E6" />

        <!-- Thin ScrollBar Styles -->
        <SolidColorBrush x:Key="ThinScrollBarThumbBrush" Color="#808080" Opacity="0.45" />
        <SolidColorBrush x:Key="ThinScrollBarThumbHoverBrush" Color="#808080" Opacity="0.8" />
        <SolidColorBrush x:Key="ThinScrollBarThumbPressedBrush" Color="#808080" Opacity="1.0" />

        <Style x:Key="ThinScrollBarThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumbBorder"
                                Background="{StaticResource ThinScrollBarThumbBrush}"
                                CornerRadius="3"
                                Margin="1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="{StaticResource ThinScrollBarThumbHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="{StaticResource ThinScrollBarThumbPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False" />
            <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="True" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}" Visibility="Collapsed" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThinScrollBarThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}" Visibility="Collapsed" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="Height" Value="6" />
                                <Setter Property="MinHeight" Value="6" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource AppButtonBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AppButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AppAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AppAccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="PrimaryIconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AppAccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{StaticResource AppInputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AppTextBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AppAccentBrush}" />
        </Style>

        <Style TargetType="{x:Type PasswordBox}">
            <Setter Property="Background" Value="{StaticResource AppInputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="{StaticResource AppInputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="toggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="1"
                                          Foreground="{TemplateBinding Foreground}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="comboBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="comboBorder" Property="Background" Value="{StaticResource AppPanelAltBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="comboBorder" Property="BorderBrush" Value="{StaticResource AppAccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="8,2,28,2"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <TextBlock Text="v"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Margin="0,0,9,1"
                                       Foreground="{StaticResource AppMutedTextBrush}" />
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Background="{StaticResource AppPanelBrush}"
                                        BorderBrush="{StaticResource AppBorderBrush}"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="260">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="toggleButton" Property="Background" Value="{StaticResource AppPanelAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Background" Value="{StaticResource AppPanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="itemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource AppAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource AppPanelAltBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
        </Style>

        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="tabBorder"
                                Background="#202023"
                                BorderBrush="{StaticResource AppBorderBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="3,3,0,0"
                                Margin="0,0,3,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource AppPanelBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource AppPanelAltBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="{StaticResource AppInputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="RowBackground" Value="{StaticResource AppPanelBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{StaticResource AppPanelAltBrush}" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{StaticResource AppPanelAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="{StaticResource AppPanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        </Style>

        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="Padding" Value="6,3" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" Background="{StaticResource AppPanelBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Vertical" VerticalAlignment="Center">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                x:Name="ReloadSsmsContextButton"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Reload saved SSMS context"
                                Margin="8,0,0,0"
                                Click="ReloadSsmsContextButton_Click">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                        </Button>
                        <Button DockPanel.Dock="Right"
                            x:Name="OpenSchemaExplorerButton"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Open Schema Explorer"
                            Margin="8,0,0,0"
                            Click="OpenSchemaExplorerButton_Click">
                            <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                        </Button>
                        <TextBlock Text="MSSQL IntelliSense Debugger"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource AppTextBrush}" />
                    </DockPanel>
                    <TextBlock x:Name="SsmsContextText"
                               Text="Loading saved SSMS config..."
                               Foreground="{StaticResource AppMutedTextBrush}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Connection"
                               Grid.Row="0"
                               Grid.Column="0"
                               Foreground="{StaticResource AppMutedTextBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <ComboBox x:Name="SavedConnectionComboBox"
                              Grid.Row="0"
                              Grid.Column="1"
                              MinWidth="0"
                              SelectionChanged="SavedConnectionComboBox_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Database"
                               Grid.Row="2"
                               Grid.Column="0"
                               Foreground="{StaticResource AppMutedTextBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <ComboBox x:Name="SavedDatabaseComboBox"
                              Grid.Row="2"
                              Grid.Column="1"
                              MinWidth="0"
                              SelectionChanged="SavedDatabaseComboBox_SelectionChanged" />
                </Grid>
            </Grid>
        </Border>

        <Grid Visibility="Collapsed">
            <TextBox x:Name="ConnectionStringTextBox" TextChanged="ConnectionStringTextBox_TextChanged" />
            <TextBox x:Name="DatabaseNameTextBox" TextChanged="DatabaseNameTextBox_TextChanged" />
            <PasswordBox x:Name="ApiKeyPasswordBox" PasswordChanged="ApiKeyPasswordBox_PasswordChanged" />
            <Button x:Name="SaveSettingsButton" Click="SaveSettingsButton_Click" />
            <Button x:Name="RefreshMetadataButton" Click="RefreshMetadataButton_Click" />
        </Grid>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="1">
            <!-- Tab 1: AI Agent Chat -->
            <TabItem Header="Chat">
                <Border Background="{StaticResource AppPanelBrush}" Padding="4">
                    <ssms:ChatAgentControl x:Name="DebugChatAgentControl" />
                </Border>
            </TabItem>

            <!-- Tab 2: AI Tool Lab -->
            <TabItem Header="Tools">
                <Border Background="{StaticResource AppPanelBrush}" Padding="4">
                    <ssms:ToolLabControl x:Name="DebugToolLabControl" ShowConnectionSelector="False" />
                </Border>
            </TabItem>

            <!-- Tab 3: SQL Completion Engine Tester -->
            <TabItem Header="Complete">
                <Border Background="{StaticResource AppPanelBrush}" Padding="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="SQL Input" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}" VerticalAlignment="Center" />
                            <Button x:Name="RunCompletionButton" Click="RunCompletionButton_Click" DockPanel.Dock="Right" Style="{StaticResource PrimaryIconButtonStyle}" ToolTip="Run completion">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                            </Button>
                            <Button x:Name="ReviewCompletionButton" Click="ReviewCompletionButton_Click" DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" ToolTip="Review selected completion" Margin="0,0,6,0" IsEnabled="False">
                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                            </Button>
                        </DockPanel>

                        <TextBox Grid.Row="1" x:Name="SqlInputTextBox" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="13" Padding="8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextChanged="SqlInputTextBox_TextChanged" SelectionChanged="SqlInputTextBox_SelectionChanged" Text="SELECT * FROM dbo.Users u JOIN " />

                        <TextBlock Grid.Row="2" Text="Suggestions" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}" Margin="0,8,0,4" />

                        <DataGrid Grid.Row="3" x:Name="CompletionResultsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="CompletionResultsDataGrid_SelectionChanged" MouseDoubleClick="CompletionResultsDataGrid_MouseDoubleClick" PreviewMouseLeftButtonDown="CompletionResultsDataGrid_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="CompletionResultsDataGrid_PreviewMouseLeftButtonUp" PreviewMouseMove="CompletionResultsDataGrid_PreviewMouseMove">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="64" />
                                <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*" />
                                <DataGridTextColumn Header="Insert" Binding="{Binding InsertText}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="4" Text="Preview" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}" Margin="0,8,0,4" />

                        <TextBox Grid.Row="5" x:Name="CompletionDescriptionPreview" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="11.5" Padding="6" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>
            </TabItem>

            <!-- Tab 4: Metadata Cache & JSON Inspector -->
            <TabItem Header="Cache">
                <Border Background="{StaticResource AppPanelBrush}" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <Button x:Name="LoadCacheJsonButton" Click="LoadCacheJsonButton_Click" DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" ToolTip="Reload cache JSON">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                            </Button>
                            <StackPanel>
                                <TextBlock x:Name="CachePathStatusText" Text="Cache File Path: Loading..." Foreground="{StaticResource AppMutedTextBrush}" />
                            </StackPanel>
                        </DockPanel>

                        <TextBox Grid.Row="1" x:Name="CacheJsonViewerTextBox" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="11.5" Padding="8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="{StaticResource AppAccentBrush}" Foreground="White" Margin="0,6,0,0">
            <StatusBarItem Padding="4,0">
                <TextBlock x:Name="StatusBarText" Text="Ready" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
