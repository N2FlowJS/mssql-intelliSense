<Window x:Class="MssqlIntelliSense.DebugApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ssms="clr-namespace:MssqlIntelliSense.SsmsHost;assembly=MssqlIntelliSense.SsmsHost"
        mc:Ignorable="d"
        Title="MSSQL IntelliSense - Standalone UI Debugger" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="#D4D4D4">

    <Window.Resources>
        <!-- Thin ScrollBar Styles -->
        <SolidColorBrush x:Key="ThinScrollBarThumbBrush" Color="#808080" Opacity="0.45" />
        <SolidColorBrush x:Key="ThinScrollBarThumbHoverBrush" Color="#808080" Opacity="0.8" />
        <SolidColorBrush x:Key="ThinScrollBarThumbPressedBrush" Color="#808080" Opacity="1.0" />

        <Style x:Key="ThinScrollBarThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumbBorder"
                                Background="{StaticResource ThinScrollBarThumbBrush}"
                                CornerRadius="3"
                                Margin="1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="{StaticResource ThinScrollBarThumbHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="{StaticResource ThinScrollBarThumbPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False" />
            <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="True" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}" Visibility="Collapsed" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThinScrollBarThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}" Visibility="Collapsed" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="Height" Value="6" />
                                <Setter Property="MinHeight" Value="6" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header & Connection Bar -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Row 0: App Title & Quick Status -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🛠 MSSQL IntelliSense Debugger" FontWeight="Bold" FontSize="15" Foreground="#569CD6" />
                    <TextBlock Text=" [Standalone UI Runner]" Foreground="#858585" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SaveSettingsButton" Content="💾 Save Settings" Click="SaveSettingsButton_Click" Padding="10,4" Margin="0,0,6,0" Background="#0E639C" Foreground="White" BorderThickness="0" />
                    <Button x:Name="RefreshMetadataButton" Content="🔄 Scan Schema" Click="RefreshMetadataButton_Click" Padding="10,4" Background="#3A3D41" Foreground="White" BorderThickness="0" />
                </StackPanel>

                <!-- Row 1: Connection & AI Config Controls -->
                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Conn Str:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#CCCCCC" FontSize="11" />
                    <TextBox Grid.Column="1" x:Name="ConnectionStringTextBox" Padding="6,4" Background="#333337" Foreground="#F1F1F1" BorderBrush="#555555" TextChanged="ConnectionStringTextBox_TextChanged" FontSize="11" />

                    <TextBlock Grid.Column="2" Text="Database:" VerticalAlignment="Center" Margin="10,0,6,0" Foreground="#CCCCCC" FontSize="11" />
                    <TextBox Grid.Column="3" x:Name="DatabaseNameTextBox" Padding="6,4" Background="#333337" Foreground="#F1F1F1" BorderBrush="#555555" TextChanged="DatabaseNameTextBox_TextChanged" FontSize="11" />

                    <TextBlock Grid.Column="4" Text="Gemini Key:" VerticalAlignment="Center" Margin="10,0,6,0" Foreground="#CCCCCC" FontSize="11" />
                    <PasswordBox Grid.Column="5" x:Name="ApiKeyPasswordBox" Padding="6,4" Background="#333337" Foreground="#F1F1F1" BorderBrush="#555555" PasswordChanged="ApiKeyPasswordBox_PasswordChanged" FontSize="11" />
                </Grid>
            </Grid>
        </Border>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="1" Background="#1E1E1E" BorderBrush="#3F3F46">
            <!-- Tab 1: AI Agent Chat -->
            <TabItem Header="🤖 SQL AI Agent Chat" Foreground="#D4D4D4" FontSize="12" Padding="12,6">
                <Border Background="#252526" Padding="4">
                    <ssms:ChatAgentControl x:Name="DebugChatAgentControl" />
                </Border>
            </TabItem>

            <!-- Tab 2: AI Tool Lab -->
            <TabItem Header="🧪 AI Tool Lab" Foreground="#D4D4D4" FontSize="12" Padding="12,6">
                <Border Background="#252526" Padding="4">
                    <ssms:ToolLabControl x:Name="DebugToolLabControl" />
                </Border>
            </TabItem>

            <!-- Tab 3: SQL Completion Engine Tester -->
            <TabItem Header="⚡ Completion Engine Tester" Foreground="#D4D4D4" FontSize="12" Padding="12,6">
                <Border Background="#252526" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="420" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: SQL Query Editor -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="SQL Query Input:" FontWeight="SemiBold" Foreground="#4EC9B0" VerticalAlignment="Center" />
                                <Button x:Name="RunCompletionButton" Content="⚡ Trigger Completion" Click="RunCompletionButton_Click" DockPanel.Dock="Right" Padding="8,3" Background="#0E639C" Foreground="White" BorderThickness="0" />
                            </DockPanel>

                            <TextBox Grid.Row="1" x:Name="SqlInputTextBox" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="13" Background="#1E1E1E" Foreground="#D4D4D4" BorderBrush="#3F3F46" Padding="8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextChanged="SqlInputTextBox_TextChanged" SelectionChanged="SqlInputTextBox_SelectionChanged" Text="SELECT * FROM dbo.Users u JOIN " />
                        </Grid>

                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#3F3F46" />

                        <!-- Right: Suggestions & DDL Preview -->
                        <Grid Grid.Column="2" Margin="6,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Completion Suggestions Output:" FontWeight="SemiBold" Foreground="#CE9178" Margin="0,0,0,6" />

                            <DataGrid Grid.Row="1" x:Name="CompletionResultsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="#1E1E1E" Foreground="#D4D4D4" BorderBrush="#3F3F46" RowBackground="#252526" AlternatingRowBackground="#2D2D30" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#333337" SelectionChanged="CompletionResultsDataGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="70" />
                                    <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="160" />
                                    <DataGridTextColumn Header="Insert Text" Binding="{Binding InsertText}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Grid.Row="2" Text="DDL / Description Tooltip Preview:" FontWeight="SemiBold" Foreground="#DCDCAA" Margin="0,8,0,4" />

                            <TextBox Grid.Row="3" x:Name="CompletionDescriptionPreview" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="11.5" Background="#1E1E1E" Foreground="#9CDCFE" BorderBrush="#3F3F46" Padding="6" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- Tab 4: Metadata Cache & JSON Inspector -->
            <TabItem Header="🗄️ Metadata Cache Inspector" Foreground="#D4D4D4" FontSize="12" Padding="12,6">
                <Border Background="#252526" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock x:Name="CachePathStatusText" Text="Cache File Path: Loading..." Foreground="#858585" VerticalAlignment="Center" />
                            <Button x:Name="LoadCacheJsonButton" Content="📂 Reload Cache JSON" Click="LoadCacheJsonButton_Click" DockPanel.Dock="Right" Padding="8,3" Background="#3A3D41" Foreground="White" BorderThickness="0" />
                        </DockPanel>

                        <TextBox Grid.Row="1" x:Name="CacheJsonViewerTextBox" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="11.5" Background="#1E1E1E" Foreground="#CE9178" BorderBrush="#3F3F46" Padding="8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#007ACC" Foreground="White" Margin="0,6,0,0">
            <StatusBarItem x:Name="StatusBarText" Content="Ready. Connected to debug mode." />
        </StatusBar>
    </Grid>
</Window>
