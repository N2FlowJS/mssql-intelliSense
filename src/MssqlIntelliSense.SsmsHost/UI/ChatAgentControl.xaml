<UserControl x:Class="MssqlIntelliSense.SsmsHost.ChatAgentControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="520"
             d:DesignWidth="800"
             Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}">
    <UserControl.Resources>
        <!-- Modern Thin ScrollBar Styles -->
        <SolidColorBrush x:Key="ThinScrollBarThumbBrush" Color="#808080" Opacity="0.45" />
        <SolidColorBrush x:Key="ThinScrollBarThumbHoverBrush" Color="#808080" Opacity="0.8" />
        <SolidColorBrush x:Key="ThinScrollBarThumbPressedBrush" Color="#808080" Opacity="1.0" />

        <Style x:Key="ThinScrollBarThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumbBorder"
                                Background="{StaticResource ThinScrollBarThumbBrush}"
                                CornerRadius="3"
                                Margin="1" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="{StaticResource ThinScrollBarThumbHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="{StaticResource ThinScrollBarThumbPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False" />
            <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="True" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}" Visibility="Collapsed" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThinScrollBarThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}" Visibility="Collapsed" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="Height" Value="6" />
                                <Setter Property="MinHeight" Value="6" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatCommandButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowCodeBlockBackgroundBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}" />
        </Style>

        <Style x:Key="IconCommandButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource FlatCommandButtonStyle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="IconGlyphStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PrimaryCommandButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource FlatCommandButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.SystemHighlightBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.SystemHighlightTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.SystemHighlightBrushKey}}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="10,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}"
                BorderThickness="0,0,0,1"
                Padding="2,0,2,6"
                Margin="0,0,0,6">
            <DockPanel LastChildFill="True">
                <Button x:Name="ClearChatButton"
                        DockPanel.Dock="Right"
                        Click="ClearChatButton_Click"
                        Style="{StaticResource IconCommandButtonStyle}"
                        ToolTip="Clear conversation history">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource IconGlyphStyle}" />
                </Button>

                <TextBlock Text="SQL AI Agent"
                           FontWeight="SemiBold"
                           FontSize="13"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />

                <Popup x:Name="ToolMenuPopup"
                       PlacementTarget="{Binding ElementName=ToolMenuButton}"
                       Placement="Top"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <Border BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12,10"
                            MinWidth="200"
                            Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}">
                        <StackPanel>
                            <TextBlock Text="Allowed AI Tools"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Margin="0,0,0,8"
                                       Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                            <CheckBox x:Name="ListTablesToolCheckBox" Content="List tables" IsChecked="True" Checked="ToolSelectionChanged" Unchecked="ToolSelectionChanged" Margin="0,0,0,6" Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                            <CheckBox x:Name="TableSchemaToolCheckBox" Content="Table schema" IsChecked="True" Checked="ToolSelectionChanged" Unchecked="ToolSelectionChanged" Margin="0,0,0,6" Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                            <CheckBox x:Name="TableRelationsToolCheckBox" Content="Relations" IsChecked="True" Checked="ToolSelectionChanged" Unchecked="ToolSelectionChanged" Margin="0,0,0,6" Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                            <CheckBox x:Name="TableIndexesToolCheckBox" Content="Indexes" IsChecked="True" Checked="ToolSelectionChanged" Unchecked="ToolSelectionChanged" Margin="0,0,0,6" Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                            <CheckBox x:Name="SearchObjectsToolCheckBox" Content="Search objects" IsChecked="True" Checked="ToolSelectionChanged" Unchecked="ToolSelectionChanged" Margin="0,0,0,6" Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                            <CheckBox x:Name="FindColumnToolCheckBox" Content="Find column" IsChecked="True" Checked="ToolSelectionChanged" Unchecked="ToolSelectionChanged" Margin="0,0,0,6" Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                            <CheckBox x:Name="ListEndpointsToolCheckBox" Content="List endpoints" IsChecked="True" Checked="ToolSelectionChanged" Unchecked="ToolSelectionChanged" Margin="0,0,0,6" Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                            <CheckBox x:Name="ExecuteSqlToolCheckBox" Content="Execute read-only SQL" IsChecked="True" Checked="ToolSelectionChanged" Unchecked="ToolSelectionChanged" Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                        </StackPanel>
                    </Border>
                </Popup>
            </DockPanel>
        </Border>

        <!-- Chat Messages Container -->
        <ScrollViewer x:Name="ChatMessagesScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                      Padding="2,0,2,4">
            <StackPanel x:Name="ChatMessagesPanel" Orientation="Vertical" />
        </ScrollViewer>

        <!-- Input -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}"
                BorderThickness="0,1,0,0"
                Padding="0,8,0,0"
                Margin="0,6,0,0"
                Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="ChatInputTextBox"
                             Grid.Column="0"
                             MinHeight="54"
                             MaxHeight="120"
                             Background="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBackgroundBrushKey}}"
                             Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxTextBrushKey}}"
                             BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBorderBrushKey}}"
                             Padding="8,6"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             FontSize="12"
                             PreviewKeyDown="ChatInputTextBox_PreviewKeyDown" />

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Margin="6,0,0,0">
                        <Button x:Name="ToolMenuButton"
                                Click="ToolMenuButton_Click"
                                Margin="0,0,0,3"
                                Style="{StaticResource IconCommandButtonStyle}"
                                Width="30"
                                MinWidth="30"
                                Height="26"
                                MinHeight="26"
                                ToolTip="Configure active chat tools">
                            <Grid Width="24" Height="22">
                                <TextBlock Text="&#xE713;" Style="{StaticResource IconGlyphStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border x:Name="ToolBadgeBorder"
                                        Background="{DynamicResource {x:Static vsui:EnvironmentColors.SystemHighlightBrushKey}}"
                                        CornerRadius="5"
                                        MinWidth="12"
                                        Height="12"
                                        Padding="2,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,-2,-2,0"
                                        IsHitTestVisible="False">
                                    <TextBlock x:Name="ToolBadgeText"
                                               Text="8"
                                               FontSize="8.5"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.SystemHighlightTextBrushKey}}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>

                        <Button x:Name="SendChatButton"
                                Click="SendChatButton_Click"
                                Style="{StaticResource PrimaryCommandButtonStyle}"
                                Width="30"
                                MinWidth="30"
                                Height="26"
                                MinHeight="26"
                                Padding="0"
                                FontWeight="SemiBold"
                                IsDefault="True"
                                ToolTip="Send message">
                            <TextBlock Text="&#xE724;" Style="{StaticResource IconGlyphStyle}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <DockPanel Grid.Row="1" Margin="0,4,0,0">
                    <TextBlock Text="Ctrl + Enter to send"
                               DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               FontSize="10.5"
                               Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.PanelTextBrushKey}}" />
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
