<UserControl x:Class="MssqlIntelliSense.SsmsHost.TreeJsonControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MssqlIntelliSense.SsmsHost"
             mc:Ignorable="d"
             d:DesignHeight="320"
             d:DesignWidth="760"
             Background="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxTextBrushKey}}">
    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type local:TreeJsonNode}" ItemsSource="{Binding Children}">
            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}"
                           FontFamily="Consolas"
                           FontSize="10.5"
                           FontWeight="{Binding NameWeight}"
                           Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Separator}"
                           FontFamily="Consolas"
                           FontSize="10.5"
                           Margin="1,0,3,0"
                           Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.PanelTextBrushKey}}" />
                <TextBlock Grid.Column="2"
                           Text="{Binding DisplayValue}"
                           FontFamily="Consolas"
                           FontSize="10.5"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{Binding ValueBrush}" />
                <TextBlock Grid.Column="3"
                           Text="{Binding Detail}"
                           FontSize="9.5"
                           Margin="4,0,0,0"
                           Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.PanelTextBrushKey}}" />
            </Grid>
        </HierarchicalDataTemplate>

        <Style x:Key="TreeJsonCommandButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="22" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="Height" Value="20" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource {x:Static vsui:EnvironmentColors.SystemButtonFaceBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.SystemButtonTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}" />
        </Style>

        <Style x:Key="TreeJsonIconGlyphStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="{x:Type TreeViewItem}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,2">
            <TextBlock x:Name="StatusTextBlock"
                       VerticalAlignment="Center"
                       FontSize="10"
                       Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.PanelTextBrushKey}}"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource TreeJsonCommandButtonStyle}"
                        ToolTip="Expand one level"
                        Click="ExpandAllButton_Click">
                    <TextBlock Text="&#xE70D;" Style="{StaticResource TreeJsonIconGlyphStyle}" />
                </Button>
                <Button Style="{StaticResource TreeJsonCommandButtonStyle}"
                        ToolTip="Collapse JSON tree"
                        Click="CollapseAllButton_Click">
                    <TextBlock Text="&#xE70E;" Style="{StaticResource TreeJsonIconGlyphStyle}" />
                </Button>
                <Button Style="{StaticResource TreeJsonCommandButtonStyle}"
                        ToolTip="Copy JSON"
                        Click="CopyButton_Click">
                    <TextBlock Text="&#xE8C8;" Style="{StaticResource TreeJsonIconGlyphStyle}" />
                </Button>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <TreeView x:Name="JsonTreeView"
                      ItemsSource="{Binding RootNodes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      Padding="0"
                      Background="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBackgroundBrushKey}}"
                      BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBorderBrushKey}}" />

            <TextBox x:Name="RawTextBox"
                     Visibility="Collapsed"
                     IsReadOnly="True"
                     TextWrapping="NoWrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas, Courier New, monospace"
                     FontSize="10.5"
                     Padding="4"
                     Background="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBackgroundBrushKey}}"
                     Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxTextBrushKey}}"
                     BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ComboBoxBorderBrushKey}}" />
        </Grid>
    </Grid>
</UserControl>
